# Environment template for the trace-filtering / evaluation scripts.
# Copy this to `.env` and fill in your own values.  The real `.env` is gitignored
# (never commit live keys; rotate any key that is accidentally exposed).

# --- OpenAI (GPT-5-mini reasoning-trace verifier / filter) ---
# Used by: scripts/verify_15k_traces.py, verify_6k_traces.py, verify_c1_union.py,
#          smoke_test_gpt5mini.py, verify_traces_openai_original.py
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Vertex AI (Gemini judge / Gemini teacher-benchmark) ---
# Used by: scripts/04_eval/explainability_judge_multi.py (the 5-axis judge),
# scripts/04_eval/evaluate_qwen25vl_7b_trainprompt.py --gemini, the phase1a/phase1b
# Gemini judge and correction passes, and scripts/03_rollout_star/run_llava_post_rollout.sh.
# All of them read these three from the environment. Point the credentials var at your own
# service-account JSON (do NOT commit the JSON):
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/vertex-service-account.json
GOOGLE_CLOUD_PROJECT=your-vertex-project-id
GOOGLE_CLOUD_LOCATION=global

# --- Google AI Studio (Gemini API key, trace grounding audit) ---
# Used by: scripts/00_generate/trace_audit/audit_traces_gemini.py. Read from the
# environment only. run_full_sweep.sh will also source a mode-600 shell fragment if you
# point GEMINI_KEYFILE at one (default $HOME/.gemini_audit_key). Never inside the repo.
GEMINI_API_KEY=your-gemini-api-key

# --- Workspace root (optional) ---
# The directory that holds Training/, outputs/, hf_cache/ and LlamaFactory/. Every script
# added for the LLaVA / Qwen3 / Arm-D / audit lines defaults it to the parent of this
# repository; set it explicitly if your layout differs.
# WORK_DIR=/path/to/workspace
